diff --git a/meta/AttrKeyMap.cpp b/meta/AttrKeyMap.cpp
index 9da52df6..5311a890 100644
--- a/meta/AttrKeyMap.cpp
+++ b/meta/AttrKeyMap.cpp
@@ -62,8 +62,10 @@ std::string AttrKeyMap::constructKey(
 
     if (switchId == SAI_NULL_OBJECT_ID)
     {
-        SWSS_LOG_THROW("switchId is NULL for %s",
-                sai_serialize_object_meta_key(metaKey).c_str());
+        /* CSP-7550: orchagent 202511 puede construir claves antes de conocer el
+         * switch id. Antes abortaba el proceso; ahora se avisa y se sigue. */
+        SWSS_LOG_WARN("constructKey: switchId is NULL for object type %d, continuing",
+                (int)metaKey.objecttype);
     }
 
     // Use map to make sure that keys will be always sorted by attr id.
@@ -78,9 +80,12 @@ std::string AttrKeyMap::constructKey(
 
         if (!md)
         {
-            SWSS_LOG_THROW("failed to get metadata for object type: %s and attr id: %d",
-                    sai_serialize_object_id(metaKey.objecttype).c_str(),
-                    attr.id);
+            /* CSP-7550: SONiC 202511 puede recibir atributos heredados (p.ej. "NULL")
+             * que no existen en los metadatos. Antes abortaba el proceso entero;
+             * ahora se omiten: la clave se construye con el resto. */
+            SWSS_LOG_WARN("constructKey: metadata missing for object type %d attr id %d, skipping",
+                    (int)metaKey.objecttype, attr.id);
+            continue;
         }
 
         const auto& value = attr.value;
@@ -133,8 +138,10 @@ std::string AttrKeyMap::constructKey(
             default:
 
                 // NOTE: only primitive types should be considered as keys
-                SWSS_LOG_THROW("FATAL: attribute %s marked as key, but have invalid serialization type, FIXME",
+                /* CSP-7550: tipo no soportado -> se omite el atributo en lugar de abortar. */
+                SWSS_LOG_WARN("constructKey: attr %s marked as key with unsupported serialization type, skipping",
                         md->attridname);
+                continue;
         }
 
         keys[md->attrid] = name;
